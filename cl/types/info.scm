(define-public (info-type group param-name)
  (let* ([l (assoc-ref infoz group)]
	 [type (if l
		   (assoc-ref l param-name)
		   (error "group not found" group))])
    type))
(define-public (read-info group param-name bv sz)
  ;;specfic cond clauses are faster than pattern matching or equal?-ing to lists
  (let ([type (info-type group param-name)])
    (when (not type)
      (error "param-name not found" param-name))
    (let ([ret (match type
		 [(t) (refbv t bv 0)]
		 [(4 '*) (string-reader bv sz)]
		 [(t '*) (map (lambda (ix)
				(refbv t bv ix))
			      (iota sz))]
		 [(4 '* '*)
		  (map (lambda (ix)
			 (ffi:pointer->string
			  (ffi:make-pointer
			   (bytevector-u64-native-ref bv (* 8 ix)))))
		       (iota (/ sz 8)))]
		 [else  (error "reader not implemented: " group param-name type)])])
      ret)))
(define-public (allocate-info-bv group param-name count)
  (let ([type (info-type group param-name)])
    (cond
     [(or (not (list? type)) (null? type))
      (error "error in allocate-info-bv not implemented: " group param-name type)]
     [(null? (cdr type)) (allocate (car type) 1)]
     [(null? (cddr type))
      (allocate (car type) count)]
     [(and (equal? (car type) 4)
	   (equal? (cadr type) '*)
	   (equal? (caddr type) '*))
      (allocate '* count)]
     [else  (error "error in allocate-info-bv not found: " group param-name type)])))
(define-public (bytes->count group param-name sz)
  (let ([type (info-type group param-name)])
    (match type
      [(t) (/ sz (ffi:sizeof t))]
      [(4 '*) sz]
      [(t '*) (/ sz (ffi:sizeof t))]
      [(4 '* '*) sz]
      [else  (error "bytes->count not implemented: "
		    group param-name type)])))
